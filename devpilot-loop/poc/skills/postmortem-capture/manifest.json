{
  "name": "postmortem-capture",
  "version": "2.0.0",
  "description": "汇总全流程 trace，生成复盘报告，沉淀 Runbook 与 Skill 模板",
  "entry": "main",
  "permissions": [
    "write:knowledge-base"
  ],
  "dependencies": [
    {
      "name": "llm-gateway",
      "type": "mcp"
    },
    {
      "name": "knowledge-base-mcp",
      "type": "mcp"
    }
  ],
  "author": "DevPilot Loop Contributors",
  "license": "Apache-2.0",
  "tags": [
    "postmortem",
    "knowledge",
    "runbook"
  ],
  "failure_policy": {
    "max_retries": 3,
    "retry_backoff": "exponential",
    "timeout_seconds": 120,
    "fallback_action": "local_file_storage",
    "on_failure_notify": [
      "devlead",
      "knowledge"
    ]
  },
  "security_boundary": {
    "required_permissions": [
      "write:knowledge-base"
    ],
    "forbidden_actions": [
      "deploy:execute",
      "write:git-repo"
    ],
    "data_classification": "internal"
  },
  "reuse_value": "可被多个 Agent 复用；可独立安装为 Python 包"
}