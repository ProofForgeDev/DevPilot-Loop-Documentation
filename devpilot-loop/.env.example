# DevPilot Loop — 环境变量模板
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件已加入 .gitignore，请勿提交真实值

# === Agent 配置 ===
AGENT_NAME=devlead
AGENT_TYPE=manager
SKILL_NAME=defect-triage
MANAGER_URL=http://localhost:8008

# === LLM 网关（Higress/OpenAI 兼容）===
LLM_ENDPOINT=http://higress:8080/v1/chat/completions
LLM_MODEL=qwen-turbo
LLM_API_KEY=${HIGRESS_API_KEY}

# === Matrix 通信（HiClaw AgentTeams）===
MATRIX_HOME_SERVER=https://matrix.devpilot.local
MATRIX_USER_ID=@devpilot:devpilot.local
MATRIX_ACCESS_TOKEN=${MATRIX_TOKEN}

# === 可观测性（OpenTelemetry）===
OTEL_SERVICE_NAME=devpilot-loop
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
OTEL_TRACES_SAMPLER=always_on

# === 凭证存储 ===
CREDENTIAL_STORE_PATH=/tmp/devpilot-credentials.json

# === 安全阈值 ===
SECURITY_SCAN_THRESHOLD=HIGH
MAX_RETRY_COUNT=3
TASK_TIMEOUT_SECONDS=120
