# ============================================================
# DevPilot Loop — Worker Agent 基础镜像
# ============================================================
# 基于 AgentTeams openclaw-base，预装 HiClaw CLI
# 通过 AGENT_NAME 和 SKILL_NAME 环境变量区分不同 Worker
# 参考: https://github.com/agentscope-ai/AgentTeams
# ============================================================

FROM agentteams/openclaw-base:20260423-8359cbc

# 安装 AgentTeams CLI
COPY --from=agentteams/agentteams-controller:latest \
  /usr/local/bin/agt /usr/local/bin/agt

# 复制 Skill 包（只读挂载）
COPY poc/skills /opt/devpilot/skills

# 复制 Agent 配置（只读挂载）
COPY poc/deploy/agents /opt/devpilot/agents

# 设置工作目录
WORKDIR /opt/devpilot

# 运行时参数（由 docker-compose 注入）
ARG AGENT_NAME=intake
ARG SKILL_NAME=defect-triage

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD agt agent health ${AGENT_NAME} || exit 1

# 启动入口
ENTRYPOINT ["agt", "agent", "run", "--type", "worker", "--name", "${AGENT_NAME}", "--skill", "${SKILL_NAME}"]
